ANTHROPIC_API_KEY=sk-ant-...
APP_PASSWORD=choose-a-password
# Provided automatically by Railway/Render in production; falls back to 8787 locally.
PORT=8787
# Where the SQLite file lives. On Railway/Render, point this at a mounted
# Volume/Disk path, otherwise the DB resets on every redeploy.
DB_PATH=./data/english_buddy.db
